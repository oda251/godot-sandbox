[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/modes/back_button.gd" id="1_back"]

[node name="Demo2D" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_back")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Center/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 40
text = "2D Demo"
horizontal_alignment = 1

[node name="ComingSoon" type="Label" parent="Center/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "coming soon"
