[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/start_screen.gd" id="1_start"]

[node name="StartScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_start")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Center/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 48
text = "godot-sandbox"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "select a mode"
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="Center/VBox"]
custom_minimum_size = Vector2(0, 24)
layout_mode = 2

[node name="ShooterButton" type="Button" parent="Center/VBox"]
custom_minimum_size = Vector2(240, 44)
layout_mode = 2
text = "Shooter"

[node name="Spacer2" type="Control" parent="Center/VBox"]
custom_minimum_size = Vector2(0, 16)
layout_mode = 2

[node name="QuitButton" type="Button" parent="Center/VBox"]
custom_minimum_size = Vector2(240, 36)
layout_mode = 2
text = "Quit"

[node name="Footer" type="Label" parent="."]
layout_mode = 1
anchors_preset = 7
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -60.0
offset_top = -32.0
offset_right = 60.0
offset_bottom = -12.0
grow_horizontal = 2
grow_vertical = 0
theme_override_font_sizes/font_size = 12
text = "v0.1.0"
horizontal_alignment = 1
modulate = Color(1, 1, 1, 0.5)

[connection signal="pressed" from="Center/VBox/ShooterButton" to="." method="_on_shooter_pressed"]
[connection signal="pressed" from="Center/VBox/QuitButton" to="." method="_on_quit_pressed"]
